# ── Pandit Ji Express backend configuration ──────────────────────────────────
# Copy to `.env`. Defaults run locally on SQLite with no external services.

APP_ENV=development
DEBUG=true
APP_NAME=Pandit Ji Express

# Database. Local dev default is SQLite. For Postgres in production set e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/panditji
DATABASE_URL=sqlite+aiosqlite:///./panditji.db

# JWT — MUST be set to a real secret in production (the app refuses to start
# in production while this is the placeholder).
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Refresh cookie (auto-secure in production)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS — the public site + admin origin(s), comma-separated
CORS_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_ENQUIRY_PER_HOUR=8

# On-demand ISR revalidation of the Next.js frontend when content is published.
# The backend POSTs here so routine content edits never need a redeploy.
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me-revalidate-secret

# Public site base URL (used in sitemap.xml, canonicals, JSON-LD)
SITE_URL=http://localhost:3000

# Seed admin (created by `python seed.py`) — change for any real deployment
SEED_ADMIN_EMAIL=admin@panditjiexpress.in
SEED_ADMIN_PASSWORD=Admin!Pandit123
