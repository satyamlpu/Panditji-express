# Server-side only — the FastAPI backend origin (never exposed to the browser).
BACKEND_URL=http://localhost:8099

# Public site base URL (used for canonicals, sitemap, JSON-LD, OG).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for on-demand ISR revalidation. MUST match REVALIDATE_SECRET in
# the backend .env, so only the backend can trigger a public re-render.
REVALIDATE_SECRET=change-me-revalidate-secret
