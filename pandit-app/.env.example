# Partner app — environment config (copy to .env for local overrides).
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time, so they
# must NOT contain secrets. Only public config belongs here.

# Backend API base URL. Leave unset for local dev (defaults to
# http://localhost:8099, or http://10.0.2.2:8099 on the Android emulator).
# Staging/production builds set this per EAS profile, e.g.:
#   EXPO_PUBLIC_API_BASE=https://panditji-express2.vercel.app
EXPO_PUBLIC_API_BASE=
